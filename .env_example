COMPOSE_PROJECT_NAME=ec_tg_bot_v2

# ============================================================
# Droplet (docker-compose.yml): bot, scheduler, pi_server, postgres
# ============================================================

# Postgres creds.
# Pin the major version you initialised the volume with (check: docker compose exec postgres postgres --version).
# `latest` silently jumps to a new major version, which Postgres can't open without a manual upgrade.
POSTGRES_IMAGE_TAG=latest
# Host port for local tools (alembic/psql from the host). Containers always use postgres:5432.
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Telegram API token received from BotFather
TELEGRAM_TOKEN=<fillme>

# Public port pi_server listens on (must match DROPLET_PORT on the Pis)
PI_SERVER_PORT=5566

# scheduler cron job interval to analyze heartbeats
LISTEN_HEARTBEAT_INTERVAL_SECONDS=10

# bot cron job interval to parse status changes
BOT_NOTIFICATION_POLL_INTERVAL_SECONDS=60

# ============================================================
# Shared: must be identical on the droplet and on every Pi
# ============================================================

# Serves for auth between pi_client(s) and pi_server
HEARTBEAT_TOKEN=<fillme>

# ============================================================
# Raspberry Pi (docker-compose.pi.yml): pi_client
# ============================================================

# Address of dedicated server where docker compose is deployed
DROPLET_IP=localhost
DROPLET_PORT=5566

# Marks each pi_client. Must be exactly one of: POWER, GENERATOR (see src/enums.py)
HEARTBEAT_LABEL=<fillme>

# pi_client request sending interval
SEND_HEARTBEAT_INTERVAL_SECONDS=10
